#!/bin/busybox sh
# Minimal debug initramfs for HTC ChaCha (stage 3):
# fbcon message, USB RNDIS (172.16.42.1), DHCP for the host, telnetd, shell on tty1.

/bin/busybox --install -s /bin
export PATH=/bin:/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
# No DEVTMPFS: it hangs this kernel at boot. tmpfs + mdev instead.
mount -t tmpfs -o mode=0755 tmpfs /dev
mknod -m 600 /dev/console c 5 1
mknod -m 666 /dev/null c 1 3
echo /bin/mdev > /proc/sys/kernel/hotplug
mdev -s
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

msg() {
	echo "[chacha-init] $*" > /dev/kmsg
	echo "[chacha-init] $*" > /dev/tty0
}

msg "initramfs up: $(uname -r)"

# Backlight on (Android normally does it from userspace)
for b in /sys/class/leds/lcd-backlight/brightness; do
	[ -w "$b" ] && echo 255 > "$b"
done

# USB: HTC android composite gadget — switch to RNDIS only
for f in adb usb_mass_storage; do
	[ -w /sys/class/usb_composite/$f/enable ] && echo 0 > /sys/class/usb_composite/$f/enable
done
echo 1 > /sys/class/usb_composite/rndis/enable
msg "rndis enable=$(cat /sys/class/usb_composite/rndis/enable)"

i=0
while [ ! -e /sys/class/net/usb0 ] && [ $i -lt 20 ]; do
	sleep 1
	i=$((i + 1))
done
ifconfig lo 127.0.0.1 up
if ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up; then
	# Alpine's static busybox has no telnetd/udhcpd: plain shell over nc,
	# host needs a static 172.16.42.2/24.
	nc -lk -s 172.16.42.1 -p 23 -e /bin/sh &
	msg "shell: nc 172.16.42.1 23"
else
	msg "usb0 missing!"
fi

# Root on SD card: /dev/mmcblk0p1 (ext4). "rdshell" on cmdline keeps us here.
if ! grep -qw rdshell /proc/cmdline; then
	mkdir -p /newroot
	i=0
	while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 10 ]; do
		sleep 1
		mdev -s
		i=$((i + 1))
	done
	if mount -t ext4 -o rw,noatime /dev/mmcblk0p1 /newroot && [ -x /newroot/sbin/init ]; then
		# No usable RTC (Android uses /dev/alarm): the clock starts in 1980 and
		# OpenRC then regenerates its whole deptree on every boot. Restore the
		# time saved by swclock at shutdown before handing over.
		t=$(stat -c %Y /newroot/var/lib/misc/openrc-shutdowntime 2>/dev/null)
		[ -n "$t" ] && [ "$t" -gt "$(date +%s)" ] && date -s "@$t" >/dev/null
		msg "switch_root to /dev/mmcblk0p1"
		kill $(pidof nc) 2>/dev/null
		umount /dev/pts /tmp
		mount --move /dev /newroot/dev
		mount --move /sys /newroot/sys
		mount --move /proc /newroot/proc
		exec switch_root /newroot /sbin/init
	fi
	msg "no usable rootfs on /dev/mmcblk0p1, staying in initramfs"
fi

# Local shell on the screen (keyboard test)
setsid sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1' &

while true; do
	sleep 3600
done
