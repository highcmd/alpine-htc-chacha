#!/sbin/openrc-run
# Screen, keyboard and touch-key backlights (microp LEDs). The panel's lcd-backlight-gate
# trigger only fires on Android early-suspend, so plain brightness values are used.

description="Screen, keyboard and touch-key backlights"

LEDS=/sys/class/leds

start() {
	ebegin "Setting backlights (keyboard ${KEYBOARD:-on}, buttons ${BUTTONS:-0})"
	# keyboard-backlight is a GPO: any non-zero value is fully on
	[ "${KEYBOARD:-on}" = on ] && kbd=255 || kbd=0
	echo $kbd > $LEDS/keyboard-backlight/brightness &&
		echo "${BUTTONS:-0}" > $LEDS/button-backlight/brightness &&
		{ [ -z "$SCREEN" ] || echo "$SCREEN" > $LEDS/lcd-backlight/brightness; }
	eend $?
}

# the screen stays lit: switching it off on stop would leave the console dark
stop() {
	ebegin "Switching keyboard and touch-key backlights off"
	echo 0 > $LEDS/keyboard-backlight/brightness
	echo 0 > $LEDS/button-backlight/brightness
	eend 0
}
