#!/sbin/openrc-run
# CPU frequency limit and governor (msm cpufreq, 245.76-800 MHz)

description="CPU frequency limit and governor"

CPUFREQ=/sys/devices/system/cpu/cpu0/cpufreq

start() {
	ebegin "Setting CPU frequency (${GOVERNOR:-default}, max ${MAX_FREQ:-default})"
	{ [ -z "$MAX_FREQ" ] || echo "$MAX_FREQ" > $CPUFREQ/scaling_max_freq; } &&
		{ [ -z "$GOVERNOR" ] || echo "$GOVERNOR" > $CPUFREQ/scaling_governor; }
	eend $?
}
