#!/bin/sh
# chacha-config: WiFi, console font and backlight setup for the HTC ChaCha.
# Menus use letters (digits need FN on the ChaCha keyboard); Enter = back.
# Lines are kept short so the menus still fit with a 16x32 font (30x10).

IFACE=wlan0
WPA="wpa_cli -i $IFACE"
FONTDIR=/usr/share/consolefonts
FONTCONF=/etc/conf.d/consolefont
CONSOLE=/dev/tty1
SCR_W=480	# ChaCha panel, pixels
SCR_H=320
LETTERS="a b c d e f g h i j k l m n o p q r s t u v w x y z"

[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }

say() { printf '%s\n' "$*"; }
pause() { printf '\n[Enter] '; read -r _; }
ask() {	# ask "prompt" -> $REPLY
	printf '%s' "$1"
	IFS= read -r REPLY || exit 0
}
confirm() {	# confirm "question" -> default no
	ask "$1 [y/N] "
	case $REPLY in y|Y) return 0 ;; esac
	return 1
}
header() {
	clear
	say "== chacha-config: $1 =="
	say ""
}
# letter_at N -> Nth letter (1-based)
letter_at() { n_=$1; set -- $LETTERS; eval "printf %s \"\${$n_}\""; }
# index_of LETTER -> 1-based index, empty if not a letter
index_of() {
	i=1
	for l in $LETTERS; do
		[ "$l" = "$1" ] && { echo $i; return; }
		i=$((i + 1))
	done
}

# ---------------------------------------------------------------- WiFi

wpa_ok() {
	$WPA ping 2>/dev/null | grep -q PONG && return 0
	say "wpa_supplicant is not running:"
	say "  rc-service wpa_supplicant-chacha restart"
	pause
	return 1
}

wifi_state() { $WPA status 2>/dev/null | sed -n "s/^$1=//p"; }

wifi_ip() { ip -4 addr show dev $IFACE 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1; }

wifi_summary() {
	st=$(wifi_state wpa_state)
	if [ "$st" = COMPLETED ]; then
		echo "$(wifi_state ssid) ${WIFI_IP:-$(wifi_ip)}"
	else
		echo "${st:-none} (not connected)"
	fi
}

sec_of() {	# scan flags -> short security label
	case $1 in
	*EAP*) echo EAP ;;
	*SAE*) case $1 in *PSK*) echo WPA2 ;; *) echo WPA3 ;; esac ;;
	*WPA2*) echo WPA2 ;;
	*WPA*) echo WPA ;;
	*WEP*) echo WEP ;;
	*) echo open ;;
	esac
}

# dBm -> 0..4 bars
bars() {
	s=${1#-}
	if [ "$s" -le 55 ]; then echo "####"
	elif [ "$s" -le 67 ]; then echo "### "
	elif [ "$s" -le 78 ]; then echo "##  "
	else echo "#   "
	fi
}

wifi_scan() {
	header "scan"
	wpa_ok || return
	say "Scanning..."
	n=0
	for try in 1 2 3; do
		$WPA scan >/dev/null 2>&1
		sleep 4
		# bssid freq signal flags ssid; strongest first, one line per SSID
		$WPA scan_results 2>/dev/null | tail -n +2 |
			awk -F'\t' '$5 != ""' | sort -t "$(printf '\t')" -k3,3nr |
			awk -F'\t' '!seen[$5]++' | head -26 > /tmp/chacha-scan
		n=$(wc -l < /tmp/chacha-scan)
		[ "$n" -gt 0 ] && break
	done

	saved=$($WPA list_networks 2>/dev/null | tail -n +2 | cut -f2)
	cur=$(wifi_state ssid)
	header "networks ($n)"
	i=1
	while IFS="$(printf '\t')" read -r bssid freq sig flags ssid; do
		ch=$(( (freq - 2407) / 5 ))
		mark=" "
		printf '%s\n' "$saved" | grep -qxF -- "$ssid" && mark="+"
		[ "$ssid" = "$cur" ] && mark="*"
		printf '%s)%s%-16.16s %s %-4s %2s\n' "$(letter_at $i)" "$mark" "$ssid" \
			"$(bars "$sig")" "$(sec_of "$flags")" "$ch"
		i=$((i + 1))
	done < /tmp/chacha-scan
	[ "$n" -eq 0 ] && say "Nothing found."
	say ""
	say "* connected  + saved"
	say "1) hidden network (enter SSID)"
	ask "Choose [Enter=back]: "
	case $REPLY in
	"") return ;;
	1)
		ask "SSID: "
		[ -n "$REPLY" ] || return
		wifi_connect "$REPLY" WPA2 hidden
		return ;;
	esac
	k=$(index_of "$REPLY")
	[ -n "$k" ] && [ "$k" -le "$n" ] || return
	line=$(sed -n "${k}p" /tmp/chacha-scan)
	flags=$(printf '%s' "$line" | cut -f4)
	ssid=$(printf '%s' "$line" | cut -f5-)
	wifi_connect "$ssid" "$(sec_of "$flags")" scanned
}

# wifi_connect SSID SECURITY scanned|hidden
wifi_connect() {
	ssid=$1 sec=$2 how=$3
	header "connect: $ssid"
	case $sec in
	EAP|WPA3|WEP)
		say "$sec networks are not supported"
		say "(only WPA/WPA2-PSK and open)."
		pause
		return ;;
	esac

	psk=""
	if [ "$sec" != open ]; then
		while :; do
			printf 'Password: '
			stty -echo 2>/dev/null
			IFS= read -r psk
			stty echo 2>/dev/null
			echo
			[ -n "$psk" ] || return
			len=${#psk}
			[ "$len" -ge 8 ] && [ "$len" -le 63 ] && break
			say "A WPA password has 8-63 characters (got $len)."
		done
		if confirm "Show password?"; then
			say "  $psk"
			confirm "Correct?" || return
		fi
	fi

	# drop older entries for this SSID
	$WPA list_networks | tail -n +2 | while IFS="$(printf '\t')" read -r id s _; do
		[ "$s" = "$ssid" ] && $WPA remove_network "$id" >/dev/null
	done

	id=$($WPA add_network | tail -1)
	case $id in ''|*[!0-9]*) say "add_network: $id"; pause; return ;; esac
	if [ "$how" = hidden ]; then
		hex=$(printf '%s' "$ssid" | od -An -tx1 | tr -d ' \n')
		$WPA set_network "$id" ssid "$hex" >/dev/null
		$WPA set_network "$id" scan_ssid 1 >/dev/null
	else
		# scan_results prints SSIDs printf-escaped; P"..." parses that form
		$WPA set_network "$id" ssid "P\"$ssid\"" >/dev/null
	fi
	if [ "$sec" = open ]; then
		$WPA set_network "$id" key_mgmt NONE >/dev/null
	else
		$WPA set_network "$id" psk "\"$psk\"" | grep -q OK ||
			{ say "Could not set the password."; $WPA remove_network "$id" >/dev/null; pause; return; }
	fi
	$WPA select_network "$id" >/dev/null

	printf 'Connecting'
	ok=""
	for t in $(seq 1 30); do
		sleep 1
		printf '.'
		[ "$(wifi_state wpa_state)" = COMPLETED ] && { ok=1; break; }
	done
	echo
	$WPA enable_network all >/dev/null

	if [ -z "$ok" ]; then
		say "Not connected ($(wifi_state wpa_state))."
		[ "$sec" != open ] && say "Wrong password or weak signal."
		if confirm "Keep this network anyway?"; then
			$WPA save_config >/dev/null
		else
			$WPA remove_network "$id" >/dev/null
			$WPA save_config >/dev/null
		fi
		pause
		return
	fi
	$WPA save_config >/dev/null
	say "Connected. Saved to"
	say "  /etc/wpa_supplicant/wpa_supplicant.conf"

	# udhcpc runs in the background from ifup (-b); ask it to renew now
	printf 'DHCP'
	pid=$(cat /var/run/udhcpc.$IFACE.pid 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		kill -USR1 "$pid"
	else
		ifup -f $IFACE >/dev/null 2>&1 &
	fi
	WIFI_IP=""
	for t in $(seq 1 20); do
		sleep 1
		printf '.'
		WIFI_IP=$(wifi_ip)
		[ -n "$WIFI_IP" ] && break
	done
	echo
	if [ -n "$WIFI_IP" ]; then
		say "IP address: $WIFI_IP"
	else
		say "No DHCP address (yet?)."
	fi
	pause
}

wifi_saved() {
	while :; do
		header "saved networks"
		wpa_ok || return
		$WPA list_networks | tail -n +2 > /tmp/chacha-nets
		n=$(wc -l < /tmp/chacha-nets)
		i=1
		while IFS="$(printf '\t')" read -r id ssid bssid flags; do
			st=""
			case $flags in *CURRENT*) st=" (connected)" ;; *DISABLED*) st=" (disabled)" ;; esac
			printf '%s) %s%s\n' "$(letter_at $i)" "$ssid" "$st"
			i=$((i + 1))
		done < /tmp/chacha-nets
		[ "$n" -eq 0 ] && say "No saved networks."
		say ""
		ask "Remove which? [Enter=back]: "
		[ -n "$REPLY" ] || return
		k=$(index_of "$REPLY")
		[ -n "$k" ] && [ "$k" -le "$n" ] || continue
		id=$(sed -n "${k}p" /tmp/chacha-nets | cut -f1)
		ssid=$(sed -n "${k}p" /tmp/chacha-nets | cut -f2)
		if confirm "Remove \"$ssid\"?"; then
			$WPA remove_network "$id" >/dev/null
			$WPA save_config >/dev/null
		fi
	done
}

wifi_status() {
	header "WiFi status"
	wpa_ok || return
	$WPA status | grep -E '^(wpa_state|ssid|bssid|freq|ip_address|key_mgmt)='
	sig=$(iwconfig $IFACE 2>/dev/null | sed -n 's/.*Signal level[=:]\([-0-9]*\).*/\1/p')
	[ -n "$sig" ] && say "signal=$sig dBm"
	say "ip=$(wifi_ip)"
	gw=$(ip route | sed -n "s/^default via \([0-9.]*\) dev $IFACE.*/\1/p" | head -1)
	[ -n "$gw" ] && say "gateway=$gw"
	pause
}

# ---------------------------------------------------------------- font

# font_dims FILE -> "W H" from the PSF1/PSF2 header
font_dims() {
	set -- $(gzip -dc "$1" 2>/dev/null | head -c 32 | od -An -tu1)
	if [ "$1" = 54 ] && [ "$2" = 4 ]; then
		echo "8 $4"
	elif [ "$1" = 114 ] && [ "$2" = 181 ]; then
		shift 24
		echo "$(( $5 + $6 * 256 )) $(( $1 + $2 * 256 ))"
	fi
}

font_label() {	# font_label FILE -> "6x12 80x26"
	set -- $(font_dims "$1")
	[ -n "$1" ] || { echo "?"; return; }
	echo "${1}x$2 $((SCR_W / $1))x$((SCR_H / $2))"
}

font_current() { sed -n 's/^consolefont="\{0,1\}\([^"]*\)"\{0,1\}/\1/p' "$FONTCONF"; }

font_apply() { setfont -C "$CONSOLE" "$FONTDIR/$1" 2>&1; }

font_try() {	# font_try NAME: preview, confirm (auto-revert), save
	old=$(font_current)
	err=$(font_apply "$1") || { say "setfont: $err"; pause; return; }
	header "font"
	say "$1 ($(font_label "$FONTDIR/$1"))"
	say ""
	say "Preview: abcdefghijklmnopqrstuvwxyz"
	say "         ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	say "         0123456789 []{}<>|\\~^\`"
	say ""
	say "Without an answer within 20 s"
	say "the previous font comes back."
	printf 'Keep it? [y/N] '
	if read -r -t 20 REPLY && case $REPLY in y|Y) true ;; *) false ;; esac; then
		sed -i "s|^consolefont=.*|consolefont=\"$1\"|" "$FONTCONF"
		say "Saved to $FONTCONF"
		pause
	else
		echo
		font_apply "$old" >/dev/null
	fi
}

# Terminus families: code page 2 = ISO 8859-2 (Central European, Polish letters).
# The u/v variants have 512 glyphs, which halves the console colours to 8.
font_menu() {
	while :; do
		cur=$(font_current)
		header "console font"
		say "Now: $cur"
		say "     ($(font_label "$FONTDIR/$cur"))"
		say ""
		say "a) Terminus"
		say "b) Terminus bold"
		say "c) other (VGA, DR-DOS...)"
		say ""
		ask "Choose [Enter=back]: "
		case $REPLY in
		a) font_sizes "ter-2??n.psf.gz" ;;
		b) font_sizes "ter-2??b.psf.gz" ;;
		c) font_sizes "default8x*.psfu.gz drdos8x*.psfu.gz iso01-12x22.psfu.gz LatGrkCyr-12x22.psfu.gz Lat2-Terminus16.psfu.gz" ;;
		"") return ;;
		esac
	done
}

font_sizes() {	# font_sizes "GLOB..."
	header "size"
	: > /tmp/chacha-fonts
	for f in $(cd "$FONTDIR" && ls $1 2>/dev/null); do
		set -- $(font_dims "$FONTDIR/$f")
		[ -n "$1" ] && echo "$(( $1 * $2 )) $f" >> /tmp/chacha-fonts
	done
	sort -n /tmp/chacha-fonts | cut -d' ' -f2 > /tmp/chacha-fonts.s
	n=$(wc -l < /tmp/chacha-fonts.s)
	say "   glyph  screen  file"
	i=1
	while read -r f; do
		set -- $(font_label "$FONTDIR/$f")
		printf '%s) %-6s %-7s %s\n' "$(letter_at $i)" "$1" "$2" "${f%%.psf*}"
		i=$((i + 1))
	done < /tmp/chacha-fonts.s
	say ""
	ask "Choose [Enter=back]: "
	k=$(index_of "$REPLY")
	[ -n "$k" ] && [ "$k" -le "$n" ] || return
	font_try "$(sed -n "${k}p" /tmp/chacha-fonts.s)"
}

# ---------------------------------------------------------------- backlight

LEDS=/sys/class/leds
BLCONF=/etc/conf.d/chacha-backlight

IDLECONF=/etc/conf.d/chacha-idle

# bl_get VAR [FILE], bl_set VAR VALUE [FILE]
bl_get() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}/\1/p" "${2:-$BLCONF}"; }
bl_set() { sed -i "s/^$1=.*/$1=\"$2\"/" "${3:-$BLCONF}"; }

idle_label() {
	case $1 in
	0) echo "never" ;;
	*) echo "$(($1 / 60)) min" ;;
	esac
}

bl_buttons_label() {
	case $1 in
	0) echo "off" ;;
	*) echo "$1/255" ;;
	esac
}

# The keyboard LED is on/off only; the touch keys are PWM (0..255)
backlight_menu() {
	while :; do
		kbd=$(bl_get KEYBOARD)
		btn=$(bl_get BUTTONS)
		idle=$(bl_get IDLE_TIMEOUT "$IDLECONF")
		header "backlight"
		say "Keyboard:   ${kbd:-on}"
		say "Touch keys: $(bl_buttons_label "${btn:-0}")"
		say "Idle off:   $(idle_label "${idle:-300}")"
		say ""
		say "k) keyboard on/off"
		say "a) touch keys: off"
		say "b) touch keys: low"
		say "c) touch keys: medium"
		say "d) touch keys: full"
		say "t) switch off when idle"
		say ""
		say "Saved at once, kept after"
		say "a reboot."
		say ""
		ask "Choose [Enter=back]: "
		case $REPLY in
		k)
			if [ "${kbd:-on}" = on ]; then kbd=off; v=0; else kbd=on; v=255; fi
			echo $v > $LEDS/keyboard-backlight/brightness
			bl_set KEYBOARD $kbd ;;
		a|b|c|d)
			case $REPLY in a) v=0 ;; b) v=32 ;; c) v=96 ;; d) v=255 ;; esac
			echo $v > $LEDS/button-backlight/brightness
			bl_set BUTTONS $v ;;
		t) idle_menu ;;
		"") return ;;
		esac
	done
}

# chacha-idle switches all backlights off; any key or touch wakes the screen
idle_menu() {
	header "idle"
	say "All backlights go off after"
	say "this long without a key/touch."
	say "The waking key is not typed."
	say "Power key: press = screen off/on,"
	say "hold 3 s = power off."
	say ""
	say "a) 1 min   b) 2 min   c) 5 min"
	say "d) 10 min  e) 30 min  f) never"
	say ""
	ask "Choose [Enter=back]: "
	case $REPLY in
	a) v=60 ;; b) v=120 ;; c) v=300 ;; d) v=600 ;; e) v=1800 ;; f) v=0 ;;
	*) return ;;
	esac
	bl_set IDLE_TIMEOUT $v "$IDLECONF"
	rc-service chacha-idle restart >/dev/null 2>&1
}

# ---------------------------------------------------------------- main

trap 'stty echo 2>/dev/null; rm -f /tmp/chacha-scan /tmp/chacha-nets /tmp/chacha-fonts /tmp/chacha-fonts.s' EXIT
trap 'exit 1' INT TERM

while :; do
	header "menu"
	say "WiFi: $(wifi_summary)"
	say "Font: $(font_current | sed "s/\.psf.*//")"
	say ""
	say "w) WiFi: scan and connect"
	say "z) WiFi: saved networks"
	say "s) WiFi: status"
	say "f) console font"
	say "p) backlight and idle"
	say ""
	ask "Choose [Enter=quit]: "
	case $REPLY in
	w) wifi_scan ;;
	z) wifi_saved ;;
	s) wifi_status ;;
	f) font_menu ;;
	p) backlight_menu ;;
	"") clear; exit 0 ;;
	esac
done
